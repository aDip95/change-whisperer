# ══════════════════════════════════════════════════════════════════════════════
# CONFIGURAZIONE WEB MONITOR BOT
# ══════════════════════════════════════════════════════════════════════════════
# Rinomina questo file in .env e compila i campi obbligatori.

# ──────────────────────────────────────────────────────────────────────────────
# TELEGRAM BOT TOKEN (OBBLIGATORIO)
# ──────────────────────────────────────────────────────────────────────────────
# Come ottenerlo:
#   1. Apri Telegram e cerca @BotFather
#   2. Invia /newbot
#   3. Scegli un nome e un username
#   4. BotFather ti darà il token
#
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ──────────────────────────────────────────────────────────────────────────────
# CHAT ID (OBBLIGATORIO)
# ──────────────────────────────────────────────────────────────────────────────
# Dove inviare le notifiche. Può essere:
#
# A) CANALE TELEGRAM (consigliato per notifiche pubbliche)
#    1. Crea un canale
#    2. Aggiungi il bot come amministratore
#    3. Ottieni l'ID con @getidsbot o @userinfobot
#    4. L'ID sarà negativo, es: -1001234567890
#
# B) GRUPPO TELEGRAM
#    1. Aggiungi il bot al gruppo
#    2. Ottieni l'ID con @getidsbot
#
# C) CHAT PRIVATA
#    1. Scrivi qualcosa al tuo bot
#    2. Visita: https://api.telegram.org/bot<TOKEN>/getUpdates
#    3. Cerca "chat":{"id": TUO_ID}
#
TELEGRAM_CHAT_ID=-1001234567890

# ──────────────────────────────────────────────────────────────────────────────
# UTENTI AUTORIZZATI (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Il bot risponde SOLO a TELEGRAM_CHAT_ID. Ogni altro update viene ignorato e
# loggato ("Update non autorizzato ignorato: chat=… user=…").
# Se comandi il bot anche in chat privata, aggiungi qui il tuo user ID
# (lo trovi in quella riga di log o con @userinfobot). Più ID separati da virgola.
#
ALLOWED_USER_IDS=

# ──────────────────────────────────────────────────────────────────────────────
# INTERVALLO DI CONTROLLO (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Ogni quanti secondi controllare i siti.
# Default: 60. Consigliato: 60-300.
#
CHECK_INTERVAL=60

# ──────────────────────────────────────────────────────────────────────────────
# SOGLIA DI CAMBIAMENTO (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Percentuale minima di cambiamento per inviare una notifica.
# Valori da 0.0 (notifica tutto) a 1.0 (notifica solo riscrittura totale).
# Default: 0.01 (1%). Consigliato: 0.01-0.05.
#
CHANGE_THRESHOLD=0.01

# ──────────────────────────────────────────────────────────────────────────────
# INTERO SITO — /add URL --whole (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Pagine e sottopagine sotto l'URL, stesso dominio. Scansione costosa: rifatta
# ogni WHOLE_SITE_INTERVAL secondi (default 900), al massimo WHOLE_SITE_MAX_PAGES
# pagine (default 100). /check la forza subito.
#
WHOLE_SITE_INTERVAL=900
WHOLE_SITE_MAX_PAGES=100

# ──────────────────────────────────────────────────────────────────────────────
# REPORT GIORNALIERO (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Report automatico giornaliero con lo stato di tutti i siti monitorati.
#   DAILY_REPORT_ENABLED : true/false per attivarlo o disattivarlo. Default: true.
#   DAILY_REPORT_HOUR    : ora del giorno (0-23) in cui inviarlo. Default: 8.
#   TIMEZONE             : fuso orario IANA di DAILY_REPORT_HOUR. Default: Europe/Rome.
# Il comando manuale /report resta sempre disponibile, anche se disattivato.
#
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=8
TIMEZONE=Europe/Rome

# ──────────────────────────────────────────────────────────────────────────────
# PATH GIF CELEBRATIVA (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# GIF inviata quando viene rilevato un cambiamento significativo.
# Se il file non esiste, viene semplicemente ignorata.
#
#   GIF_ENABLED : true/false — attivabile anche a runtime col comando /gif.
#                 La GIF non viene mai inviata per pagine svuotate o riscritte
#                 per intero. Default: false (si accende col comando /gif).
#
GIF_PATH=./data/giphy.gif
GIF_ENABLED=false

# ──────────────────────────────────────────────────────────────────────────────
# FILE SITI MONITORATI (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Percorso al file JSON dove salvare i siti monitorati.
#
SITES_FILE=./monitored_sites.json

# ──────────────────────────────────────────────────────────────────────────────
# DEDUPLICA TEMPORALE (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Un contenuto identico già notificato entro questa finestra non viene rimandato:
# è il caso della pagina che cambia, torna indietro e ricambia. 0 disattiva.
#
DEDUP_WINDOW_HOURS=6

# ──────────────────────────────────────────────────────────────────────────────
# LIVELLO DI LOG (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR. Default: INFO.
#
# LOG_FILE        : log applicativo su file, ruotato. Default: ./data/bot.log
# CHANGE_LOG_FILE : storico JSONL di ogni cambiamento rilevato (anche quelli
#                   sotto soglia): una riga JSON per evento, utile per capire a
#                   posteriori perché è arrivata (o non è arrivata) una notifica.
#                   Default: ./data/changes.jsonl
# LOG_MAX_BYTES / LOG_BACKUPS : rotazione. Default: 2000000 e 3.
#
LOG_LEVEL=INFO
LOG_FILE=./data/bot.log
CHANGE_LOG_FILE=./data/changes.jsonl

# ──────────────────────────────────────────────────────────────────────────────
# PLAYWRIGHT (OPZIONALE)
# ──────────────────────────────────────────────────────────────────────────────
# Per siti che bloccano le richieste HTTP dirette (es. portali Liferay).
# Il bot rileva automaticamente i siti che restituiscono 403 e li
# segna per usare Playwright. Puoi anche forzarlo con /browser URL.
#
# Installazione:
#   pip install playwright
#   playwright install chromium
#

